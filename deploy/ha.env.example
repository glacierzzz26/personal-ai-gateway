# AI 网关 HA 自动 failover 配置样例。
#
# 用法:复制到目标机 /opt/ai-gateway-v2/ha.env(0600),按实际填。**不入库**(deploy/.gitignore 已忽略 ha.env)。
# 由 deploy/scripts/ha-controller.sh 读取(也由 ha-controller.service 的 EnvironmentFile 兜一层)。
# 跑在**从库(aliyun)**上。见 deploy/pg-replica/README.md「自动 failover」。

# 主库主机(ssh 别名;须在 ~/.ssh/config 配好)。
PRIMARY_SSH=tencent

# 本机(从库/备用)公网 IP —— failover 时把域名 A 记录切到它。**必填**,否则 controller 拒绝切换。
STANDBY_IP=47.116.65.140

# 需要切换到本机的两个域名(及其根域)。
GATEWAY_DOMAIN=gateway.5home.online
GATEWAY_API_DOMAIN=gatewayapi.5home.online
GW_ROOT_DOMAIN=5home.online

# 连续多少轮「双信号失效」才提升(轮间隔 = timer 60s → 默认约 3 分钟才动手,避免抖动误切)。
FAIL_THRESHOLD=3

# DNS 记录 TTL(秒)。**DNSPod 免费版下限 600**,小于它会被钳到 600 —— 这也是 DNS 侧 RTO 的下限。
RECORD_TTL=600

# DNSPod 凭据文件(含 DP_Id/DP_Key);与 host-infra 的 certs.sh 同源。
DNSPOD_ENV=/etc/host-infra/dnspod.env

# 飞书机器人 webhook(告警,HA 决策 D4)。留空则该机不发告警(仅写日志)。
FEISHU_WEBHOOK=

# 飞书机器人**加签**密钥(可选)。机器人若开了「签名校验」,必须同时填此项;
# 否则 notify.sh 发明文会被飞书拒(code 19021 sign match fail)。没开加签则留空。
FEISHU_SECRET=

# 网关 compose 目录(与 pg-replication.sh 一致)。
COMPOSE_DIR=/opt/ai-gateway-v2
