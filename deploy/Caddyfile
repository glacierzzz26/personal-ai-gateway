# 生产 HTTPS 边缘:Caddy 同一实例两个 site,各挂独立自签证书(不得共用同一套)。
# 同一私域 CA 签发两张叶子(fullchain.pem = 叶子 + CA),key 各自独立。
#
# auto_https off:两个无主机名的 https:// 站点共存时 Caddy 无法建自动 TLS 策略;
# 我们全部用自签证书 + 显式 tls 指令,故关掉自动 HTTPS(不做 ACME/跳转)。

{
	auto_https off
}

# 站点地址用裸 :端口 + tls 指令开 TLS(非标准端口手动证书的标准写法);
# 不要写成 https://:端口 —— 两个无主机名的 https 站点 Caddy 无法建自动 TLS 策略。
:17080 {
	tls /certs/api/fullchain.pem /certs/api/key.pem
	handle /v1/* {
		reverse_proxy gateway:8787 {
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
}

:17090 {
	tls /certs/admin/fullchain.pem /certs/admin/key.pem
	handle /v1/* {
		respond 404
	}
	handle {
		reverse_proxy gateway:8787 {
			flush_interval -1
		}
	}
}
